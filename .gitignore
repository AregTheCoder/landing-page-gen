# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env
.env.*
!.env.example

# Run output (generated media, ledgers) and scraped snapshots. Everything
# under corpus/pages/ is rebuilt by `lp-corpus fetch --all --sectionize`;
# only the small per-page sections.md and meta.json are kept in git.
runs/
corpus/corpus.db
corpus/frames/
corpus/taxonomy/*.png
# Labelling sheets are redrawn from attributes.yaml; the manifests and the
# answers beside them are the labour and stay in git.
corpus/labels/*.png
corpus/labels/README.md
# Widened look-corpus: the yaml (URLs, provenance) stays; thumbnails are re-fetched.
corpus/widened/**/*.png
corpus/pages/*/*
!corpus/pages/*/sections.md
!corpus/pages/*/meta.json

.DS_Store
.pytest_cache/

# Per-machine Claude Code overrides
.claude/settings.local.json
