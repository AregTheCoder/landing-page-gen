{
  "permissions": {
    "allow": [
      "Bash(uv run:*)",
      "Bash(uv add:*)",
      "Bash(uv sync:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__picsart_(generate|enhance|remove_bg|change_bg|vectorize|media_video_render|media_export|media_video_create)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/credit_guard.py"
          },
          {
            "type": "command",
            "command": "python3 hooks/isolation_guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__picsart_(preflight|generate|enhance|remove_bg|change_bg|vectorize|job_status|media_video_render|media_export|media_video_create)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/log_generation.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "section-worker",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/check_result.py"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__.*__picsart_(preflight|generate|enhance|remove_bg|change_bg|vectorize|job_status|media_video_render|media_export|media_video_create)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/log_generation.py"
          }
        ]
      }
    ]
  }
}
